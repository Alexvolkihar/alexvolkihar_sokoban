{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "alexvolkihar-sokoban progress",
  "description": "Per-level records keyed by the level's canonical hash, plus the last level played (spec 9.4).",
  "type": "object",
  "required": ["format", "version", "levels", "last_played"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "alexvolkihar-sokoban/progress" },
    "version": { "const": 1 },
    "levels": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/levelHash" },
      "additionalProperties": { "$ref": "#/$defs/levelRecord" }
    },
    "last_played": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["pack_id", "level_id", "level_hash"],
          "additionalProperties": false,
          "properties": {
            "pack_id": { "type": "string" },
            "level_id": { "type": "string" },
            "level_hash": { "$ref": "#/$defs/levelHash" }
          }
        }
      ]
    }
  },
  "$defs": {
    "levelHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "solution": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["moves", "pushes", "lurd"],
          "additionalProperties": false,
          "properties": {
            "moves": { "$ref": "#/$defs/count" },
            "pushes": { "$ref": "#/$defs/count" },
            "lurd": { "type": "string", "pattern": "^[lurdLURD]*$" }
          }
        }
      ]
    },
    "levelRecord": {
      "type": "object",
      "required": [
        "pack_id", "level_id", "completed", "stars", "plays",
        "first_completed_at", "best_moves", "best_pushes", "best_time_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "pack_id": { "type": "string" },
        "level_id": { "type": "string" },
        "completed": { "type": "boolean" },
        "stars": { "type": "integer", "minimum": 0, "maximum": 3 },
        "plays": { "$ref": "#/$defs/count" },
        "first_completed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
        "best_moves": { "$ref": "#/$defs/solution" },
        "best_pushes": { "$ref": "#/$defs/solution" },
        "best_time_ms": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/count" }] }
      }
    }
  }
}
