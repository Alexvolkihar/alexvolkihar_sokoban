{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alexvolkihar/alexvolkihar_sokoban/schemas/level.schema.json",
  "title": "alexvolkihar-sokoban single level",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "rows"
  ],
  "properties": {
    "format": {
      "const": "alexvolkihar-sokoban/level"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[#@+$*. _-]*$"
      }
    },
    "par": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/par"
        }
      ]
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "$defs": {
    "par": {
      "type": "object",
      "required": [
        "pushes",
        "moves",
        "lurd",
        "solver"
      ],
      "properties": {
        "pushes": {
          "type": "integer",
          "minimum": 0
        },
        "moves": {
          "type": "integer",
          "minimum": 0
        },
        "lurd": {
          "type": "string",
          "pattern": "^[lurdLURD]*$"
        },
        "solver": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
